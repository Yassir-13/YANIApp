# Configuration du docker-compose (base de données + API).
# Copier en `.env` et compléter. Le vrai `.env` n'est jamais versionné.
#
# ⚠️ La configuration de l'APPLICATION (JWT, emails, fuseau, CORS) vit dans
# `backend/.env` — voir `backend/.env.example`. Les deux fichiers sont requis
# pour lancer `docker compose up`.

# ── PostgreSQL ───────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port exposé sur l'hôte, sur 127.0.0.1 uniquement (jamais vers l'extérieur).
POSTGRES_PORT=5432

# ── API ──────────────────────────────────────────
# Port d'écoute de l'API, dans le conteneur comme sur l'hôte.
# Sous Windows, la plage 2933–3032 est réservée par Hyper-V/WSL : si 3000 donne
# « listen EACCES », prendre 3100 par exemple.
BACKEND_PORT=3000

# '1' UNIQUEMENT si un reverse proxy de confiance (Caddy, nginx) est devant
# l'API — c'est lui qui décide si X-Forwarded-For est cru pour identifier une
# cliente, donc pour compter ses requêtes. En accès direct, cet en-tête est
# falsifiable et contournerait le rate limiting.
TRUST_PROXY=0
