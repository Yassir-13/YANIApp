# Copier ce fichier en `.env` et compléter les valeurs.
# Le vrai .env n'est jamais versionné — il contient des secrets.

NODE_ENV=development

# ── Base de données ──────────────────────────────
# Doit correspondre aux POSTGRES_* du .env à la racine (docker-compose).
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/yani_db?schema=public

# ── Authentification ─────────────────────────────
# 32 caractères minimum : un secret court se casse hors ligne et permet de
# forger un token admin. Générer avec : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# ── Compte administrateur initial (script de seed) ──
# Nom et téléphone sont obligatoires à l'inscription : les renseigner ici évite
# un compte de gérante incomplet dans la liste des clientes du backoffice.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PHONE=

# ── Divers ───────────────────────────────────────
CENTER_TIMEZONE=Africa/Casablanca
CORS_ORIGINS=http://localhost:5173
# '1' uniquement derrière un reverse proxy de confiance (voir main.ts).
TRUST_PROXY=0

# Dossier des images de prestations et de produits, servies sur /uploads.
# Vide = ./uploads (soit backend/uploads en local, /app/uploads en conteneur —
# où docker-compose monte le volume yani_uploads).
#
# ⚠️ Ces fichiers vivent hors de la base : scripts/backup.sh ne les sauvegarde
# PAS. Il faut copier ce dossier séparément.
UPLOADS_DIR=

# ── Envoi des emails ─────────────────────────────
# 'console' : aucun email ne part, les codes s'affichent dans les logs du
#             serveur. C'est le mode de développement, et le défaut.
# 'smtp'    : envoi réel. Obligatoire en production (le démarrage échoue sinon).
MAIL_DRIVER=console

# Requis uniquement si MAIL_DRIVER=smtp.
#
# Avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER = l'adresse
# complète, et SMTP_PASSWORD = un *mot de passe d'application* (Compte Google →
# Sécurité → Validation en 2 étapes → Mots de passe des applications), jamais le
# mot de passe du compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Expéditeur affiché. MAIL_FROM prend par défaut la valeur de SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Institut Yani
