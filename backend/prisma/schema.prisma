// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────

enum Role {
  CLIENT
  STAFF
  ADMIN
}

enum LoyaltyTier {
  NORMAL
  BRONZE
  SILVER
  GOLD
}

enum LoyaltyTxType {
  EARN        // points gagnés (ex : RDV complété)
  REDEEM      // points dépensés (échange récompense)
  MANUAL      // ajout manuel par le staff
  ADJUSTMENT  // correction par l'admin
  MILESTONE   // récompense de palier réclamée (offerte, 0 point dépensé)
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING     // commande passée, en attente de confirmation staff
  CONFIRMED   // staff a validé (appel client) — stock décrémenté
  READY       // préparée / prête au retrait
  COMPLETED   // remise ou livrée — points crédités
  CANCELLED   // annulée
}

enum FulfillmentType {
  PICKUP    // retrait à l'institut
  DELIVERY  // livraison à domicile
}

// ─────────────────────────────────────────────
//  UTILISATEURS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(CLIENT)
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  loyaltyAccount     LoyaltyAccount?
  appointments       Appointment[]
  refreshTokens RefreshToken[]
  loyaltyTx          LoyaltyTransaction[] @relation("AccountOwner")
  createdTransactions LoyaltyTransaction[] @relation("TransactionCreator")
  orders             Order[]

  @@map("users")
}

// ─────────────────────────────────────────────
//  FIDÉLITÉ
// ─────────────────────────────────────────────

model LoyaltyAccount {
  id            String      @id @default(uuid())
  userId        String      @unique @map("user_id")
  pointsBalance Int         @default(0) @map("points_balance")
  tier          LoyaltyTier @default(NORMAL)
  visitCount    Int         @default(0) @map("visit_count")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  grants       MilestoneGrant[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  accountId   String        @map("account_id")
  ownerId     String        @map("owner_id")
  pointsDelta Int           @map("points_delta")
  type        LoyaltyTxType
  createdById String?       @map("created_by")
  reason      String?       @db.VarChar(255)
  appointmentId String?     @unique @map("appointment_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  rewardId    String?       @map("reward_id")
  orderId     String?       @unique @map("order_id")

  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner       User           @relation("AccountOwner", fields: [ownerId], references: [id])
  createdBy   User?          @relation("TransactionCreator", fields: [createdById], references: [id])
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  reward      Reward?       @relation(fields: [rewardId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  
  @@index([accountId])
  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────
//  RENDEZ-VOUS
// ─────────────────────────────────────────────

model Appointment {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  serviceId String            @map("service_id")
  startAt   DateTime          @map("start_at")
  status    AppointmentStatus @default(PENDING)
  // Prix de la prestation figé au moment de la réservation, comme
  // OrderItem.unitPrice pour les commandes. Sert de base au crédit fidélité,
  // pour qu'un changement de tarif ultérieur ne modifie pas les points d'un
  // RDV déjà réservé. Nullable : les RDV créés avant cette colonne n'en ont pas
  // (repli sur le prix courant côté service).
  priceAtBooking Decimal?     @db.Decimal(10, 2) @map("price_at_booking")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service             @relation(fields: [serviceId], references: [id])
  loyaltyTx LoyaltyTransaction?

  @@index([userId])
  @@index([serviceId])
  @@index([startAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────
//  CATALOGUE DE SERVICES
// ─────────────────────────────────────────────

model ServiceCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services  Service[]

  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  description String?
  durationMin Int      @map("duration_min")
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  appointments Appointment[]

  category    ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("services")
}

// ─────────────────────────────────────────────
//  CATALOGUE DE PRODUITS
// ─────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products  Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stockQty    Int      @default(0) @map("stock_qty")
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("products")
}

// ─────────────────────────────────────────────
//  HORAIRES D'OUVERTURE
// ─────────────────────────────────────────────

model OpeningHours {
  id        String   @id @default(uuid())
  dayOfWeek Int      @unique @map("day_of_week") // 0 = dimanche ... 6 = samedi
  openTime  String   @map("open_time")   // "09:00"
  closeTime String   @map("close_time")  // "19:00"
  isClosed  Boolean  @default(false) @map("is_closed")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("opening_hours")
}

// ─────────────────────────────────────────────
//  RÉCOMPENSES
// ─────────────────────────────────────────────

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int      @map("points_cost")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions LoyaltyTransaction[]
  milestones   LoyaltyMilestone[]
  grants       MilestoneGrant[]

  @@map("rewards")
}

// ─────────────────────────────────────────────
//  PALIERS DE VISITES
// ─────────────────────────────────────────────

// Un palier offre une récompense du catalogue au bout d'un certain nombre de
// visites (ex : la 10e). `recurring` le rejoue à chaque multiple du seuil.
// La récompense pointe vers le catalogue existant : l'admin n'édite le libellé
// qu'à un seul endroit.
model LoyaltyMilestone {
  id             String   @id @default(uuid())
  visitThreshold Int      @map("visit_threshold")
  rewardId       String   @map("reward_id")
  recurring      Boolean  @default(true)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  reward Reward           @relation(fields: [rewardId], references: [id])
  grants MilestoneGrant[]

  @@map("loyalty_milestones")
}

// Récompense débloquée par une cliente, en attente de réclamation.
// `cycle` = combien de fois le seuil a été franchi (1 = 10e visite, 2 = 20e…) ;
// il rend le palier récurrent tout en gardant chaque déblocage unique.
// `rewardId` est figé ici : si l'admin change la récompense du palier plus tard,
// ce qui a déjà été débloqué ne se transforme pas dans le dos des clientes
// (même logique que Appointment.priceAtBooking).
model MilestoneGrant {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  milestoneId String    @map("milestone_id")
  rewardId    String    @map("reward_id")
  cycle       Int
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  account   LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  milestone LoyaltyMilestone @relation(fields: [milestoneId], references: [id])
  reward    Reward           @relation(fields: [rewardId], references: [id])

  // Idempotence : un palier ne peut être débloqué qu'une fois par cycle et par
  // compte, même si la logique de crédit est rejouée.
  @@unique([accountId, milestoneId, cycle])
  @@index([accountId])
  @@map("milestone_grants")
}

// ─────────────────────────────────────────────
//  REFRESH TOKENS
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
//  COMMANDES (produits · paiement à la remise/livraison)
// ─────────────────────────────────────────────

model Order {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  status       OrderStatus     @default(PENDING)
  fulfillment  FulfillmentType
  // Adresse de livraison (requise uniquement si fulfillment = DELIVERY)
  address      String?
  // Total figé à la commande (somme des lignes)
  total        Decimal         @db.Decimal(10, 2)
  note         String?         // note optionnelle du client
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  loyaltyTx    LoyaltyTransaction?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  // Prix unitaire figé au moment de la commande (immuable si le produit change ensuite)
  unitPrice  Decimal  @db.Decimal(10, 2) @map("unit_price")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}