// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────

enum Role {
  CLIENT
  STAFF
  ADMIN
}

enum LoyaltyTxType {
  EARN        // points gagnés (ex : RDV complété)
  REDEEM      // points dépensés (échange récompense)
  MANUAL      // ajout manuel par le staff
  MILESTONE   // récompense de palier réclamée (offerte, 0 point dépensé)
}

// D'où vient un bon : les deux circuits de récompense de l'institut.
enum VoucherSource {
  MILESTONE // offerte par un palier de visites, puis réclamée dans l'app
  REDEEM    // achetée par la cliente avec ses points
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum VerificationPurpose {
  EMAIL_VERIFY   // confirmer l'adresse à l'inscription
  PASSWORD_RESET // réinitialiser un mot de passe oublié
}

enum OrderStatus {
  PENDING     // commande passée, en attente de confirmation staff
  CONFIRMED   // staff a validé (appel client) — stock décrémenté
  READY       // préparée / prête au retrait
  COMPLETED   // remise ou livrée — points crédités
  CANCELLED   // annulée
}

enum FulfillmentType {
  PICKUP    // retrait à l'institut
  DELIVERY  // livraison à domicile
}

// ─────────────────────────────────────────────
//  UTILISATEURS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(CLIENT)
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Date à laquelle la cliente a prouvé qu'elle recevait bien ses mails à cette
  // adresse. null = jamais confirmée. On garde la date plutôt qu'un booléen :
  // elle sert à dater la preuve, et un email modifié plus tard la remettra à null.
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Date d'exercice du droit à l'effacement. null = compte actif.
  //
  // La ligne n'est PAS supprimée : ses commandes et rendez-vous portent le
  // chiffre d'affaires de l'institut, qui doit survivre au départ de la
  // cliente. On vide donc ce qui l'identifie (email, nom, téléphone, mot de
  // passe) et on garde une coquille anonyme à laquelle l'historique reste
  // rattaché — c'est l'anonymisation, par opposition à l'effacement en cascade.
  //
  // Un compte marqué ici ne peut plus se connecter, ni recevoir d'email, ni
  // réinitialiser son mot de passe : voir auth.service.ts.
  deletedAt DateTime? @map("deleted_at")

  loyaltyAccount     LoyaltyAccount?
  appointments       Appointment[]
  refreshTokens RefreshToken[]
  verificationCodes  VerificationCode[]
  loyaltyTx          LoyaltyTransaction[] @relation("AccountOwner")
  createdTransactions LoyaltyTransaction[] @relation("TransactionCreator")
  orders             Order[]
  honoredVouchers    RewardVoucher[]      @relation("VoucherHonorer")

  @@map("users")
}

// ─────────────────────────────────────────────
//  FIDÉLITÉ
// ─────────────────────────────────────────────

model LoyaltyAccount {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  pointsBalance Int      @default(0) @map("points_balance")
  visitCount    Int      @default(0) @map("visit_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  grants       MilestoneGrant[]
  vouchers     RewardVoucher[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  accountId   String        @map("account_id")
  ownerId     String        @map("owner_id")
  pointsDelta Int           @map("points_delta")
  type        LoyaltyTxType
  createdById String?       @map("created_by")
  reason      String?       @db.VarChar(255)
  appointmentId String?     @unique @map("appointment_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  rewardId    String?       @map("reward_id")
  orderId     String?       @unique @map("order_id")

  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // `owner` = la cliente à qui appartiennent les points. En cascade, comme
  // toutes les autres données personnelles (RDV, commandes, sessions) : sans
  // ça, Prisma appliquait son défaut RESTRICT sur une relation obligatoire et
  // la suppression de compte échouait dès le premier point gagné — le droit à
  // l'effacement (CNDP) était annoncé en commentaire mais inapplicable.
  owner       User           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // `createdBy` = l'employée qui a saisi l'écriture. Volontairement SetNull et
  // NON Cascade : le départ d'une employée ne doit pas effacer les points des
  // clientes qu'elle a servies. L'écriture reste, elle ne désigne plus personne.
  createdBy   User?          @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  reward      Reward?       @relation(fields: [rewardId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  // Bon émis par cette écriture (échange de points). Absent pour les autres types.
  voucher     RewardVoucher?

  @@index([accountId])
  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────
//  RENDEZ-VOUS
// ─────────────────────────────────────────────

model Appointment {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  serviceId String            @map("service_id")
  startAt   DateTime          @map("start_at")
  status    AppointmentStatus @default(PENDING)
  // Prix de la prestation figé au moment de la réservation, comme
  // OrderItem.unitPrice pour les commandes. Sert de base au crédit fidélité,
  // pour qu'un changement de tarif ultérieur ne modifie pas les points d'un
  // RDV déjà réservé. Nullable : les RDV créés avant cette colonne n'en ont pas
  // (repli sur le prix courant côté service).
  priceAtBooking Decimal?     @db.Decimal(10, 2) @map("price_at_booking")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // Restrict, et surtout pas Cascade : un rendez-vous est une prestation
  // facturée. Supprimer une cliente ne doit PAS emporter le chiffre d'affaires
  // qu'elle a généré. Le droit à l'effacement passe par l'anonymisation de la
  // ligne `users` (voir User.deletedAt), pas par sa suppression — et si du code
  // tentait un jour `user.delete()`, cette contrainte le fera échouer bruyamment
  // au lieu de détruire l'historique en silence.
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  service   Service             @relation(fields: [serviceId], references: [id])
  loyaltyTx LoyaltyTransaction?

  @@index([userId])
  @@index([serviceId])
  @@index([startAt])
  @@map("appointments")
}

// ─────────────────────────────────────────────
//  CATALOGUE DE SERVICES
// ─────────────────────────────────────────────

model ServiceCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services  Service[]

  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  description String?
  durationMin Int      @map("duration_min")
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  appointments Appointment[]

  category    ServiceCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@map("services")
}

// ─────────────────────────────────────────────
//  CATALOGUE DE PRODUITS
// ─────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products  Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stockQty    Int      @default(0) @map("stock_qty")
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("products")
}

// ─────────────────────────────────────────────
//  OUVERTURE DU CENTRE
// ─────────────────────────────────────────────

// Une PLAGE d'ouverture, pas un jour : un même jour en porte autant que
// nécessaire (9h-12h puis 15h-19h). Un jour sans aucune ligne est fermé —
// c'est ce qui remplace l'ancien booléen `isClosed`.
//
// Les heures sont exprimées en heure LOCALE du centre, comme avant. La
// conversion vers UTC reste faite par le moteur de créneaux, qui possède la
// base des fuseaux.
model OpeningHours {
  id        String @id @default(uuid())
  dayOfWeek Int    @map("day_of_week") // 0 = dimanche ... 6 = samedi
  startTime String @map("start_time")  // "09:00"
  endTime   String @map("end_time")    // "12:00"

  // Deux plages ne peuvent pas commencer à la même heure le même jour. Le
  // chevauchement, lui, est refusé par le service : une contrainte SQL ne sait
  // pas l'exprimer sans extension.
  @@unique([dayOfWeek, startTime])
  @@map("opening_hours")
}

// Fermeture exceptionnelle : congés, jour férié, journée d'absence. Elle
// s'ajoute aux horaires hebdomadaires et prime sur eux.
//
// Les bornes sont des dates au format "AAAA-MM-JJ" et non des DateTime : une
// fermeture est un JOUR du calendrier local du centre, pas un instant. Stocker
// un instant obligerait à choisir une heure arbitraire et rouvrirait la
// question du fuseau à chaque lecture.
model Closure {
  id        String   @id @default(uuid())
  startDate String   @map("start_date") // "2026-08-20"
  endDate   String   @map("end_date")   // "2026-08-27", incluse
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startDate, endDate])
  @@map("closures")
}

// Réglages de réservation, modifiables depuis le backoffice sans redéploiement.
// Une seule ligne, d'identifiant 1 : ce ne sont pas des enregistrements, ce
// sont les réglages du centre.
model CenterSettings {
  id              Int      @id @default(1)
  capacity        Int      @default(2) // cabines réservables par l'app
  slotIntervalMin Int      @default(30) @map("slot_interval_min") // écart entre créneaux proposés
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("center_settings")
}

// ─────────────────────────────────────────────
//  RÉCOMPENSES
// ─────────────────────────────────────────────

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int      @map("points_cost")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions LoyaltyTransaction[]
  milestones   LoyaltyMilestone[]
  grants       MilestoneGrant[]
  vouchers     RewardVoucher[]

  @@map("rewards")
}

// ─────────────────────────────────────────────
//  PALIERS DE VISITES
// ─────────────────────────────────────────────

// Un palier offre une récompense du catalogue au bout d'un certain nombre de
// visites (ex : la 10e). `recurring` le rejoue à chaque multiple du seuil.
// La récompense pointe vers le catalogue existant : l'admin n'édite le libellé
// qu'à un seul endroit.
model LoyaltyMilestone {
  id             String   @id @default(uuid())
  visitThreshold Int      @map("visit_threshold")
  rewardId       String   @map("reward_id")
  recurring      Boolean  @default(true)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  reward Reward           @relation(fields: [rewardId], references: [id])
  grants MilestoneGrant[]

  @@map("loyalty_milestones")
}

// Récompense débloquée par une cliente, en attente de réclamation.
// `cycle` = combien de fois le seuil a été franchi (1 = 10e visite, 2 = 20e…) ;
// il rend le palier récurrent tout en gardant chaque déblocage unique.
// `rewardId` est figé ici : si l'admin change la récompense du palier plus tard,
// ce qui a déjà été débloqué ne se transforme pas dans le dos des clientes
// (même logique que Appointment.priceAtBooking).
model MilestoneGrant {
  id          String    @id @default(uuid())
  accountId   String    @map("account_id")
  milestoneId String    @map("milestone_id")
  rewardId    String    @map("reward_id")
  cycle       Int
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  account   LoyaltyAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  milestone LoyaltyMilestone @relation(fields: [milestoneId], references: [id])
  reward    Reward           @relation(fields: [rewardId], references: [id])
  // Bon émis à la réclamation. Absent tant que la cliente n'a pas réclamé.
  voucher   RewardVoucher?

  // Idempotence : un palier ne peut être débloqué qu'une fois par cycle et par
  // compte, même si la logique de crédit est rejouée.
  @@unique([accountId, milestoneId, cycle])
  @@index([accountId])
  @@map("milestone_grants")
}

// ─────────────────────────────────────────────
//  BONS DE RÉCOMPENSE
// ─────────────────────────────────────────────

// Ce qu'une cliente a le droit de recevoir au comptoir, et que l'institut doit
// honorer. C'est la notion qui manquait : sans elle, réclamer une récompense
// offerte la faisait disparaître des DEUX côtés (l'app filtrait sur claimedAt,
// la fiche comptoir aussi), et un échange de points ne laissait qu'une ligne
// d'historique que personne ne listait.
//
// Les deux circuits — offert par un palier, acheté avec des points — se
// rejoignent ici. Un seul objet à afficher côté cliente, une seule liste à
// traiter au comptoir.
model RewardVoucher {
  id        String        @id @default(uuid())
  // Code lisible à voix haute au comptoir (8 caractères, sans O/0/I/1).
  // Ce n'est PAS un secret : les routes staff sont déjà authentifiées. C'est
  // un identifiant court, pour ne pas dicter un UUID.
  code      String        @unique
  accountId String        @map("account_id")
  rewardId  String        @map("reward_id")
  source    VoucherSource
  // Points réellement dépensés (0 pour une récompense offerte). Figé ici :
  // si le tarif de la récompense change, ce qui a été payé ne bouge pas.
  pointsSpent Int         @default(0) @map("points_spent")
  createdAt DateTime      @default(now()) @map("created_at")

  // Remise effective au comptoir. null = encore dû.
  honoredAt   DateTime? @map("honored_at")
  honoredById String?   @map("honored_by")

  // Origine exacte, pour la traçabilité. L'unicité est le vrai garde-fou de
  // l'idempotence : une réclamation ou un échange rejoué ne peut pas émettre
  // un second bon pour le même événement.
  grantId       String? @unique @map("grant_id")
  transactionId String? @unique @map("transaction_id")

  account     LoyaltyAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reward      Reward              @relation(fields: [rewardId], references: [id])
  grant       MilestoneGrant?     @relation(fields: [grantId], references: [id], onDelete: Cascade)
  transaction LoyaltyTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Qui a remis le bon. SetNull et non Cascade, même raison que createdBy sur
  // LoyaltyTransaction : le départ d'une employée ne doit pas effacer la trace
  // de ce qui a été remis aux clientes.
  honoredBy   User?               @relation("VoucherHonorer", fields: [honoredById], references: [id], onDelete: SetNull)

  @@index([accountId])
  // La liste du comptoir ne lit que les bons dus : elle reste courte et rapide
  // même quand l'historique grossit.
  @@index([honoredAt])
  @@map("reward_vouchers")
}

// ─────────────────────────────────────────────
//  REFRESH TOKENS
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
//  CODES À USAGE UNIQUE (vérification email · mot de passe oublié)
// ─────────────────────────────────────────────

model VerificationCode {
  id         String              @id @default(uuid())
  userId     String              @map("user_id")
  purpose    VerificationPurpose
  // Seul le hash est stocké : une fuite de la base ne donne pas les codes en
  // clair, exactement comme pour les refresh tokens.
  //
  // Contrairement à RefreshToken.tokenHash, ce hash n'est PAS unique : un code
  // à 6 chiffres est court, deux clientes peuvent légitimement recevoir le même
  // au même moment. La recherche se fait donc par (userId, purpose), jamais par
  // le code seul — sinon un code deviné vaudrait pour n'importe quel compte.
  codeHash   String              @map("code_hash")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  // 6 chiffres = 1 000 000 de possibilités : sans plafond de tentatives, le code
  // se devine en quelques minutes. Ce compteur ferme cette porte.
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Émettre un nouveau code efface les précédents du même usage : au plus une
  // ligne active par cliente et par usage, donc pas de table qui gonfle ni de
  // tâche de purge à maintenir.
  @@index([userId, purpose])
  @@map("verification_codes")
}

// ─────────────────────────────────────────────
//  COMMANDES (produits · paiement à la remise/livraison)
// ─────────────────────────────────────────────

model Order {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  status       OrderStatus     @default(PENDING)
  fulfillment  FulfillmentType
  // Adresse de livraison (requise uniquement si fulfillment = DELIVERY)
  address      String?
  // Total figé à la commande (somme des lignes)
  total        Decimal         @db.Decimal(10, 2)
  note         String?         // note optionnelle du client
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Restrict : même raison que pour les rendez-vous. Une commande porte un
  // total encaissé ; il survit au départ de la cliente. Voir User.deletedAt.
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  loyaltyTx    LoyaltyTransaction?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  // Prix unitaire figé au moment de la commande (immuable si le produit change ensuite)
  unitPrice  Decimal  @db.Decimal(10, 2) @map("unit_price")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}